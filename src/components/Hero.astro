---
---

<section class="hero" id="inicio">
  <!-- Content -->
  <div class="hero-content">
    <p class="text-caption hero-label">Consultoría de optimización operativa con IA</p>

    <h1 class="text-hero hero-title">
      Optimizamos tu operación con Inteligencia Artificial.
    </h1>

    <p class="text-body hero-subtitle">
      Diagnosticamos en dónde pierdes tiempo y dinero, implementamos IA
      con seguridad de datos adaptada a tu empresa, y mantenemos a tu
      equipo en control con revisión humana en cada paso.
    </p>

    <div class="hero-cta-group">
      <a href="#contacto" class="btn btn-primary">Agenda tu diagnóstico gratis →</a>
      <a href="#caso" class="btn btn-ghost">Ver caso de éxito</a>
    </div>

    <!-- 3 pillars -->
    <div class="hero-pillars">
      <div class="hero-pillar">
        <span class="pillar-icon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </span>
        <span>Diagnóstico de cuellos de botella</span>
      </div>
      <div class="hero-pillar">
        <span class="pillar-icon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </span>
        <span>Datos cifrados o en tu servidor</span>
      </div>
      <div class="hero-pillar">
        <span class="pillar-icon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <polyline points="16 11 18 13 22 9"/>
          </svg>
        </span>
        <span>Revisión humana siempre</span>
      </div>
    </div>
  </div>

  <!-- Visual -->
  <div class="hero-visual">
    <div class="hero-visual-inner">
      <!-- Background glow -->
      <div class="bg-blob" style="width:300px;height:300px;background:rgba(232,85,61,0.07);top:-40px;right:-40px;"></div>
      <div class="bg-blob" style="width:200px;height:200px;background:rgba(27,42,74,0.05);bottom:40px;left:-20px;"></div>

      <div class="metric metric-1">
        <span class="metric-label">Tiempo en reportes</span>
        <span class="metric-value">20 min</span>
        <span class="metric-trend metric-trend--bad">↑ Por nota</span>
      </div>

      <div class="metric metric-2">
        <span class="metric-label">Errores manuales</span>
        <span class="metric-value">18%</span>
        <span class="metric-trend metric-trend--bad">↑ Crítico</span>
      </div>

      <div class="metric metric-3">
        <span class="metric-label">Procesos sin estándar</span>
        <span class="metric-value">7/10</span>
        <span class="metric-trend metric-trend--neutral">Sin control</span>
      </div>

      <div class="progress-container">
        <div class="progress-label">Optimización con IA</div>
        <div class="progress-track">
          <div class="progress-bar"></div>
        </div>
        <div style="display:flex;justify-content:space-between;margin-top:6px;">
          <span style="font-size:0.7rem;color:#8693A4;font-family:var(--font-body)">0%</span>
          <span style="font-size:0.7rem;color:#E8553D;font-weight:600;font-family:var(--font-body)">94%</span>
        </div>
      </div>

      <div class="metric metric-optimized">
        <span class="metric-label">Eficiencia lograda</span>
        <span class="metric-value">45 seg</span>
        <span class="metric-trend metric-trend--good" style="background:rgba(26,143,110,0.2);color:#6ee7b7">↓ 96% menos</span>
      </div>
    </div>
  </div>
</section>

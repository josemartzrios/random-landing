---
---

<section class="section-caso" id="caso">
  <div class="section-container">
    <div class="section-header">
      <p class="text-caption">Caso de éxito</p>
      <h2 class="text-h2">SyqueX: documentación clínica optimizada con IA</h2>
      <p class="text-body section-subtitle">
        Una clínica de psicología que redactaba notas de sesión a mano ahora
        genera expedientes completos en segundos.
      </p>
    </div>

    <!-- Before / After counters -->
    <div class="caso-grid">
      <div class="caso-before">
        <p class="text-caption" style="color:#8693A4">Antes</p>
        <div class="caso-counter">
          <span class="counter-before" id="counter-before">0</span>
          <span class="counter-unit">minutos</span>
        </div>
        <p class="text-body" style="color:#8693A4;font-size:0.9rem">por nota clínica, redactada a mano</p>
      </div>

      <div class="caso-arrow">→</div>

      <div class="caso-after">
        <p class="text-caption" style="color:#1A8F6E">Después</p>
        <div class="caso-counter">
          <span class="counter-after" id="counter-after">0</span>
          <span class="counter-unit">segundos</span>
        </div>
        <p class="text-body" style="color:#1A8F6E;font-size:0.9rem">generada con IA, revisada por el psicólogo</p>
      </div>
    </div>

    <!-- 3 pillars applied in SyqueX -->
    <div class="caso-pillars">
      <div class="caso-pillar">
        <span class="pillar-icon" style="width:40px;height:40px;border-radius:10px;background:#F2F4F7;color:#E8553D;display:flex;align-items:center;justify-content:center;margin-bottom:0.5rem">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </span>
        <span class="pillar-label">Cuello de botella</span>
        <span class="pillar-desc">20+ min redactando notas a mano</span>
      </div>

      <div class="caso-pillar">
        <span class="pillar-icon" style="width:40px;height:40px;border-radius:10px;background:#F2F4F7;color:#E8553D;display:flex;align-items:center;justify-content:center;margin-bottom:0.5rem">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </span>
        <span class="pillar-label">Datos sensibles</span>
        <span class="pillar-desc">Cifrado AES-256, NOM-004</span>
      </div>

      <div class="caso-pillar">
        <span class="pillar-icon" style="width:40px;height:40px;border-radius:10px;background:#F2F4F7;color:#E8553D;display:flex;align-items:center;justify-content:center;margin-bottom:0.5rem">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <polyline points="16 11 18 13 22 9"/>
          </svg>
        </span>
        <span class="pillar-label">Revisión humana</span>
        <span class="pillar-desc">Psicólogo aprueba antes de guardar</span>
      </div>
    </div>

    <!-- Compliance badges -->
    <div class="caso-details">
      <div class="caso-badge">Cifrado AES-256</div>
      <div class="caso-badge">Cumplimiento NOM-004</div>
      <div class="caso-badge">Revisión humana obligatoria</div>
      <div class="caso-badge">LFPDPPP</div>
    </div>

    <a href="https://syquex.mx" class="btn btn-ghost" target="_blank" rel="noopener">
      Conocer SyqueX →
    </a>
  </div>
</section>

---
---

<section class="section-revision" id="revision-humana">
  <div class="section-container">
    <div class="section-header">
      <p class="text-caption">Revisión humana</p>
      <h2 class="text-h2">La IA propone. Tu equipo decide.</h2>
      <p class="text-body section-subtitle">
        Ninguna decisión crítica se automatiza sin supervisión.
        Definimos un ciclo claro de validación humana en cada implementación.
      </p>
    </div>

    <!-- 3-step flow -->
    <div class="revision-flow">
      <div class="revision-step revision-step--ai">
        <div class="revision-step-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
          </svg>
        </div>
        <h3 class="text-h3">La IA genera</h3>
        <p class="text-body">
          El modelo analiza, procesa y produce un resultado:
          una nota, un reporte, una respuesta, una recomendación.
        </p>
      </div>

      <div class="revision-connector">
        <div class="connector-arrow"></div>
      </div>

      <div class="revision-step revision-step--human">
        <div class="revision-step-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <polyline points="16 11 18 13 22 9"/>
          </svg>
        </div>
        <h3 class="text-h3">Tu equipo revisa</h3>
        <p class="text-body">
          Una persona de tu equipo valida el resultado.
          Edita, aprueba o rechaza. La IA aprende del feedback.
        </p>
      </div>

      <div class="revision-connector">
        <div class="connector-arrow"></div>
      </div>

      <div class="revision-step revision-step--approved">
        <div class="revision-step-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
        </div>
        <h3 class="text-h3">Se confirma</h3>
        <p class="text-body">
          Solo después de la aprobación humana, el resultado
          se guarda, se envía o se ejecuta. Control total.
        </p>
      </div>
    </div>

    <!-- Trust reinforcement -->
    <div class="revision-trust">
      <div class="trust-item">
        <span class="trust-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </span>
        <span class="text-body">Sin sorpresas: nada se publica sin tu OK</span>
      </div>
      <div class="trust-item">
        <span class="trust-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
            <path d="M3 3v5h5"/>
            <path d="M12 7v5l4 2"/>
          </svg>
        </span>
        <span class="text-body">Historial de cada decisión documentado</span>
      </div>
      <div class="trust-item">
        <span class="trust-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="21" x2="4" y2="14"/>
            <line x1="4" y1="10" x2="4" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="12"/>
            <line x1="12" y1="8" x2="12" y2="3"/>
            <line x1="20" y1="21" x2="20" y2="16"/>
            <line x1="20" y1="12" x2="20" y2="3"/>
            <line x1="1" y1="14" x2="7" y2="14"/>
            <line x1="9" y1="8" x2="15" y2="8"/>
            <line x1="17" y1="16" x2="23" y2="16"/>
          </svg>
        </span>
        <span class="text-body">Tú defines qué se revisa y qué se automatiza</span>
      </div>
    </div>
  </div>
</section>
